# Sectors Financial API v2 Key (Get from https://sectors.app/api)
SECTORS_API_KEY=your_sectors_api_key_here

# Optional: OpenAI API Key for live text embeddings (defaults to local offline fallback if not set)
OPENAI_API_KEY=

# Cache TTL Settings (in seconds)
CACHE_TTL_FINANCIALS_SEC=604800 # 7 days
CACHE_TTL_NEWS_SEC=86400        # 24 hours
